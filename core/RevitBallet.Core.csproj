<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net46 for Revit 2020-2024 consumers (net46 cannot consume netstandard2.0),
         netstandard2.0 for Revit 2025+ (net8) and the test project -->
    <TargetFrameworks>net46;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>RevitBallet.Core</RootNamespace>
    <AssemblyName>RevitBallet.Core</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- the PowerShell that runs on a target machine is shared with tools/remote/revit-remote (Linux): one source of truth -->
    <EmbeddedResource Include="..\tools\remote\probe.ps1" LogicalName="remote/probe.ps1" />
    <EmbeddedResource Include="..\tools\remote\invoke.ps1" LogicalName="remote/invoke.ps1" />
  </ItemGroup>

  <!-- The test project lives in a subdirectory and has its own .csproj -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**\*" />
  </ItemGroup>
</Project>
