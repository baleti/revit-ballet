# Copy to tests/vm/ci.env (git-ignored) and adjust. Everything here describes YOUR VM host; nothing is committed.
CI_HOST2="user@vm-host"             # ssh destination of the machine that runs the VMs
CI_HOST2_KEY="$HOME/.ssh/id_vmhost" # ssh key for that host (optional)
CI_VM_DIR=/srv/vm/win               # directory on the VM host holding the images, start-vm.sh and runs/
CI_BASELINE=baseline-before-revit-ballet.qcow2   # read-only golden image with vanilla Revit installs
CI_GUEST_KEY='~/.ssh/WinDev2407Eval-revit'       # key ON THE VM HOST that logs into the guest
CI_CID=4                            # vsock CID of the CI guest (the interactive VM normally uses 3)
